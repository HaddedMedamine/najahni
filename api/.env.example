PORT=3000
DATABASE_URL="postgresql://najahni:najahni@localhost:5432/najahni?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentification
JWT_ACCESS_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Compte administrateur cree par `npm run db:seed`
SEED_ADMIN_EMAIL="admin@najahni.tn"
SEED_ADMIN_PASSWORD="ChangezMoi123!"

# Adresse du site (liens "mot de passe oublie")
APP_URL="http://localhost:5173"


SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="votre.adresse@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Najahni <votre.adresse@gmail.com>"

# Dossier des fichiers envoyes (exercices PDF, images, Word)
UPLOAD_DIR="uploads"

# Notifications WhatsApp (connexion non officielle avec le numero du centre)
CENTER_NAME="Najahni"
WHATSAPP_SESSION_DIR=".whatsapp-session"
# Limites anti-blocage : pause aleatoire entre deux messages, maximum par jour
WHATSAPP_MIN_DELAY_SECONDS=15
WHATSAPP_MAX_DELAY_SECONDS=30
WHATSAPP_DAILY_LIMIT=150
# Pas de message la nuit : de NOTIFY_NIGHT_START h a NOTIFY_MORNING_HOUR h (heure de Tunis)
NOTIFY_NIGHT_START=21
NOTIFY_MORNING_HOUR=8
